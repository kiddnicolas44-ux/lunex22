# ── Discord ───────────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app → Bot
DISCORD_BOT_TOKEN=your-bot-token-here

# From https://discord.com/developers/applications → your app → General Information
DISCORD_APP_ID=your-application-id-here

# ── Supabase ──────────────────────────────────────────────────────────────────
# MUST match the Supabase project your Luna Sentinel Guard website uses,
# so keys created in Discord appear live in the dashboard.
SUPABASE_URL=https://vpmbiscioxkfauoesyqg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Website ───────────────────────────────────────────────────────────────────
# Public URL of your Luna Sentinel Guard site (used in /v1/auth loaders)
LUNA_WEB_URL=https://luna-sentinel-guard.lovable.app

# ── Railway (auto-set) ────────────────────────────────────────────────────────
# Railway sets PORT automatically — leave blank unless your host requires it
# PORT=3000
